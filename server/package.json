{
  "name": "mediqueue-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MediQueue backend - Express, Prisma, SQLite, Socket.IO",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "node --test \"tests/utils/**/*.test.js\" \"tests/dsa/**/*.test.js\" \"tests/unit/**/*.test.js\"",
    "test:api": "node --test \"tests/integration/**/*.test.js\""
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4"
  }
}
