# SQLite database file. Relative paths are resolved from prisma/schema.prisma,
# so this produces server/prisma/mediqueue.db
DATABASE_URL="file:./mediqueue.db"

# Generated by scripts/setup-env.js. Never commit the real .env file.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="12h"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Generated by scripts/setup-env.js and used for every seeded demo account.
DEMO_PASSWORD="change-me-demo-password"
